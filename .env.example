# Frontend public values (copy into assets/js/config.js for static hosting)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
SITE_URL=https://www.giftexpress.example

# Supabase Edge Function secrets — NEVER expose these in browser JavaScript
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
MERCADOPAGO_ACCESS_TOKEN=YOUR_PRIVATE_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
